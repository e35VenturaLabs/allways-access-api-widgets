{
  "name": "@venturalabs/allways-tip-jar",
  "version": "0.1.0",
  "description": "Drop-in crypto tip jar for any website: visitors tip in the coin they hold, you receive TAO or SOL, swapped by Allways.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e35VenturaLabs/allways-access-api-widgets.git",
    "directory": "tip-jar"
  },
  "homepage": "https://github.com/e35VenturaLabs/allways-access-api-widgets/tree/main/tip-jar#readme",
  "keywords": [
    "tip-jar",
    "donations",
    "crypto",
    "bittensor",
    "tao",
    "solana",
    "allways",
    "react",
    "nextjs",
    "cloudflare"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./cloudflare-pages": {
      "types": "./dist/server/cloudflare-pages.d.ts",
      "default": "./dist/server/cloudflare-pages.js"
    },
    "./next": {
      "types": "./dist/server/next.d.ts",
      "default": "./dist/server/next.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./types": {
      "types": "./dist/shared/types.d.ts",
      "default": "./dist/shared/types.js"
    },
    "./styles.css": "./dist/react/tip-jar.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.server.json && tsc -p tsconfig.react.json && node --input-type=module -e \"import { css } from './dist/react/styles.js'; import { writeFileSync } from 'node:fs'; writeFileSync('dist/react/tip-jar.css', css);\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.react.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
